pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    environment {

        IMAGE_NAME = "bibekbajagain/nodejs-shopping"

        BUILD_TAG = "${BUILD_NUMBER}"

        APP_REPO = "https://github.com/bibek009/nodejs-shopping.git"

        GITOPS_REPO = "https://github.com/bibek009/nodejs-shopping-gitops.git"

        APP_BRANCH = "dev"

        GITOPS_BRANCH = "main"
    }

    stages {

        stage('Checkout Application') {

            steps {

                git(
                    branch: APP_BRANCH,
                    credentialsId: 'github-token',
                    url: APP_REPO
                )

            }
        }

        stage('Build Docker Image') {

            steps {

                sh """
                docker build \
                  -f devops/docker/Dockerfile \
                  -t ${IMAGE_NAME}:${BUILD_TAG} \
                  -t ${IMAGE_NAME}:latest .
                """

            }

        }

        stage('Login DockerHub') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'USER',
                        passwordVariable: 'PASS'
                    )
                ]) {

                    sh '''
                    echo "$PASS" | docker login \
                    -u "$USER" \
                    --password-stdin
                    '''

                }

            }

        }

        stage('Push Docker Image') {

            steps {

                sh """
                docker push ${IMAGE_NAME}:${BUILD_TAG}
                docker push ${IMAGE_NAME}:latest
                """

            }

        }

        stage('Checkout GitOps Repo') {

            steps {

                dir('gitops') {

                    git(
                        branch: GITOPS_BRANCH,
                        credentialsId: 'github-token',
                        url: GITOPS_REPO
                    )

                }

            }

        }

        stage('Update Deployment Manifest') {

            steps {

                dir('gitops') {

                    sh """
                    sed -i 's|image: .*|image: ${IMAGE_NAME}:${BUILD_TAG}|g' shopping/deployment.yaml
                    """

                }

            }

        }

        stage('Commit and Push GitOps Repo') {

            steps {

                dir('gitops') {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-token',
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {

                        sh """
                        git config user.email "bibekbajagain009@gmail.com"
                        git config user.name "Jenkins"

                        git add shopping/deployment.yaml

                        git diff --cached --quiet || git commit -m "Deploy image ${BUILD_TAG}"

                        git remote set-url origin https://\$GIT_USER:\$GIT_TOKEN@github.com/bibek009/nodejs-shopping-gitops.git

                        git push origin ${GITOPS_BRANCH}
                        """

                    }

                }

            }

        }

    }

    post {

        always {

            sh "docker logout || true"

            sh "docker image prune -af || true"

            sh "docker builder prune -af || true"

            cleanWs()

        }

        success {

            echo "Pipeline completed successfully."

        }

        failure {

            echo "Pipeline failed."

        }

    }

}